# Local server (do not expose publicly unless you understand the risks)
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_URL=http://127.0.0.1:8000

# Optional overrides; defaults keep all data beside the project
# DATABASE_URL=sqlite:///C:/path/to/jimsa.db
# STORAGE_DIR=C:/path/to/storage
MAX_UPLOAD_MB=4096

# faster-whisper; model downloads go to storage/models, never the source ZIP
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama: install the configured model separately with `ollama pull qwen2.5:7b`
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
REQUEST_TIMEOUT_SECONDS=120

# Optional: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# If blank, a local key is created at storage/.token_key. Back it up with your database.
TOKEN_ENCRYPTION_KEY=

# Optional public HTTPS hosting for Instagram video_url, ending at the reels directory
# Example: https://media.example.com/reels
PUBLIC_MEDIA_BASE_URL=

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram + Facebook / Meta OAuth
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
